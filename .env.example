# ─────────────────────────────────────────────────────────────
# Ghostboard environment template — copy to .env (never commit real values)
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
# NODE_ENV is set by Next.js / Docker. In production the fail-fast guards (src/lib/envGuard.ts) are active.
# Explicit escape hatches (leave unset/false in real production):
ALLOW_MEMORY_DB=false          # true = allow in-memory DB when DATABASE_URL is missing/unreachable (DATA LOSS)
ENABLE_PROD_SIMULATOR=false    # true = allow /checkout/simulator and mocked emails in production
SKIP_DB_MIGRATE=false          # true = skip `prisma migrate deploy` in docker-entrypoint.sh

# ── Database (PostgreSQL) ────────────────────────────────────
# Required in production. docker-compose overrides this with the local postgres service.
DATABASE_URL=postgresql://ghostboard:ghostboard@localhost:5432/ghostboard?schema=public
POSTGRES_USER=ghostboard
POSTGRES_PASSWORD=ghostboard
POSTGRES_DB=ghostboard

# ── Auth ─────────────────────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_SECRET=
CRON_SECRET=
# OAuth 2.0 providers (Google & GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# ── AI Providers ─────────────────────────────────────────────
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# ── Deepgram (real-time STT) ─────────────────────────────────
DEEPGRAM_API_KEY=

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Upstash Redis (sync store, rate limiting, metrics) ───────
# Required in production. docker-compose overrides these with the local redis-http proxy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Token for the local serverless-redis-http proxy (docker-compose only)
LOCAL_REDIS_REST_TOKEN=ghostboard_local_token

# ── Resend (transactional email) ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=hi@ghostboard.pro
