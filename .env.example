# ==============================================================================
# Ghostboard Environment Variables Template
# Copy this file to .env or .env.local and fill in the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PERSISTENCE (POSTGRESQL & PRISMA)
# ------------------------------------------------------------------------------
# Connection string to PostgreSQL (e.g., Supabase, Neon, AWS RDS, or local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ghostboard?schema=public"

# ------------------------------------------------------------------------------
# 3. MULTI-DEVICE REAL-TIME SYNC (UPSTASH REDIS)
# Required in production for zero-split-brain syncing across PC, Web, and Mobile.
# In local dev/test, transparently falls back to in-memory global state.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (GOOGLE GEMINI 2.5 / 3.0)
# Required for sub-second interview copilot answers and vision OCR code analysis.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 5. REAL-TIME SPEECH-TO-TEXT (DEEPGRAM NOVA-3)
# Required for ultra-low latency streaming transcription of interviewer tab audio.
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY=""

# ------------------------------------------------------------------------------
# 6. PAYMENTS & SUBSCRIPTIONS (STRIPE)
# Required for billing, plan upgrades (Free -> Pro), and webhook fulfillment.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=""

# ------------------------------------------------------------------------------
# 7. SECURITY, ADMIN & CRON AUTOMATION
# ------------------------------------------------------------------------------
# Strong master password for accessing the /admin dashboard
ADMIN_PASSWORD=""

# High-entropy bearer secret for protecting /api/cron/retention automated cleanup
CRON_SECRET=""
