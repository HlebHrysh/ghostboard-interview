{
  "name": "ghostboard-desktop",
  "version": "1.0.0",
  "description": "Ghostboard Stealth Desktop HUD - Autonomous AI Interview Copilot with Screen Share Invisibility",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --universal",
    "build:linux": "electron-builder --linux AppImage"
  },
  "keywords": [
    "ghostboard",
    "stealth-hud",
    "interview-copilot",
    "screen-share-invisible",
    "tauri",
    "electron"
  ],
  "author": "Ghostboard Team",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.ghostboard.desktop",
    "productName": "Ghostboard",
    "copyright": "Copyright © 2026 Ghostboard Team",
    "protocols": {
      "name": "ghostboard",
      "schemes": [
        "ghostboard"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
