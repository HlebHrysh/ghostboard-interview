<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardware Microphone Access for Interview Audio Transcription -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Outgoing Network Sockets for Deepgram STT, LLM Streaming, & OAuth -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Localhost network server for OAuth loopback fallback -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- User-selected file read/write for session export -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
