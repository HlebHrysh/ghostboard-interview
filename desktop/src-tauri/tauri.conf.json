{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Ghostboard",
  "version": "1.2.0",
  "identifier": "ai.ghostboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ghostboard Stealth HUD",
        "width": 720,
        "height": 480,
        "minWidth": 480,
        "minHeight": 80,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost tauri://localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:3000 http://localhost:3001 ws://localhost:3001 https://ghostboard.ai wss://ghostboard.ai https://api.deepgram.com wss://api.deepgram.com https://api.openai.com https://api.groq.com https://api.anthropic.com https://generativelanguage.googleapis.com; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' blob:; worker-src 'self' blob:; script-src 'self' blob:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "languages": ["en-US"],
        "displayLanguageSelector": false,
        "installerHooks": "hooks.nsh"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "entitlements.mac.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": null,
        "windowPosition": {
          "x": 400,
          "y": 200
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2",
          "libpipewire-0.3-0 | libpulse0"
        ],
        "section": "utils",
        "desktopTemplate": "templates/ghostboard.desktop",
        "postInstallScript": "scripts/postinst.sh",
        "postRemoveScript": "scripts/postrm.sh"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["copilot"]
      }
    },
    "updater": {
      "endpoints": [
        "https://ghostboard.ai/api/desktop/updates/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/ghostboard-ai/ghostboard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRDVEMEYyOTU1QkQxQTcKUldSQlZ1b0I2K2tJRHc1aCtPcG5yTzF6M3V3Q1VCS21zMGN1a1lYdURPekpWNGtCenUvd1dLRWkK"
    }
  }
}
