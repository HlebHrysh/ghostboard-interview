{
  "manifest_version": 3,
  "name": "Ghostboard LeetCode Copilot",
  "version": "2.0.0",
  "description": "Universal 1-click coding problem extractor for LeetCode, HackerRank, Codeforces, CodeSignal & web selection to Ghostboard HUD. Zero OCR delay, 100% technical accuracy.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ghostboard Universal Coding Copilot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://*.leetcode.com/*",
    "*://leetcode.cn/*",
    "*://*.leetcode.cn/*",
    "*://hackerrank.com/*",
    "*://*.hackerrank.com/*",
    "*://codeforces.com/*",
    "*://*.codeforces.com/*",
    "*://app.codesignal.com/*",
    "*://*.codesignal.com/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:3001/*",
    "https://ghostboard.ai/*",
    "https://*.ghostboard.ai/*",
    "<all_urls>"
  ],
  "commands": {
    "send_to_ghostboard": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Extract problem or selection & send to Ghostboard Copilot"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://*.leetcode.com/problems/*",
        "*://leetcode.cn/problems/*",
        "*://*.leetcode.cn/problems/*",
        "*://leetcode.com/*",
        "*://*.leetcode.com/*",
        "*://leetcode.cn/*",
        "*://*.leetcode.cn/*",
        "*://hackerrank.com/*",
        "*://*.hackerrank.com/*",
        "*://codeforces.com/*",
        "*://*.codeforces.com/*",
        "*://app.codesignal.com/*",
        "*://*.codesignal.com/*",
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
