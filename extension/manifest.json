{
  "manifest_version": 3,
  "name": "Ghostboard LeetCode Copilot",
  "version": "1.0.0",
  "description": "Instant 1-click LeetCode problem extractor to Ghostboard Copilot HUD. Zero OCR delays, 100% technical accuracy.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ghostboard LeetCode Copilot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://leetcode.com/*",
    "*://*.leetcode.com/*",
    "*://leetcode.cn/*",
    "*://*.leetcode.cn/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:3001/*"
  ],
  "commands": {
    "send_to_ghostboard": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Extract LeetCode problem & send to Ghostboard Copilot"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://*.leetcode.com/problems/*",
        "*://leetcode.cn/problems/*",
        "*://*.leetcode.cn/problems/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
