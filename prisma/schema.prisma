generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  plan      String   @default("free") // free, pro, lifetime
  role               String?
  trialQuestionsUsed Int      @default(0)
  stripeCustomerId   String?
  resumeContext      String?
  candidateProfile   Json?    // Detailed profile: techStack, petProjects, aiDirectives, etc.
  passwordHash       String?  // scrypt hash; null for OAuth-only accounts
  isBanned           Boolean  @default(false)
  lastActiveAt       DateTime?
  createdAt          DateTime @default(now())

  sessions Session[]
  history  History[]
  payments Payment[]

  @@index([createdAt])
  @@index([lastActiveAt])
}

model Session {
  token      String   @id @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deviceType String   @default("web") // web | desktop | phone
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model History {
  id             String @id @default(uuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id])
  title          String
  timestamp      BigInt
  durationSec    Int
  questionsCount Int
  items          Json // Stores InterviewQAItem array
  isPublic       Boolean @default(false)
  publicSlug     String? @unique

  @@index([userId])
  @@index([publicSlug])
}

model Payment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  email       String
  plan        String   // pro, lifetime
  amountCents Int
  status      String   @default("succeeded") // succeeded, failed, refunded
  timestamp   BigInt
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
